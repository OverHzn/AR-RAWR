func rec(t *testing.T, fn string, args []any, out any, err error) {
	t.Helper()
	c := map[string]any{"fn": fn, "args": args}
	if err != nil {
		c["error"] = err.Error()
	} else {
		c["ok"] = out
	}
	b, _ := json.Marshal(c)
	fmt.Println(string(b))
}

func TestZZOracle(t *testing.T) {
	// (string) -> string
	strToStr := map[string]func(string) string{
		"validatePassword":        validatePassword,
		"proxyURLString":          proxyURLString,
		"identity":                identity,
		"shellQuote":              shellQuote,
		"normalizeEvidenceText":   normalizeEvidenceText,
		"shortQuote":              shortQuote,
		"trimTrailingSlash":       trimTrailingSlash,
		"truncateReply":           truncateReply,
		"normFilter":              normFilter,
		"yamlScalar":              yamlScalar,
		"sanitizeFilename":        sanitizeFilename,
		"truncateBody":            truncateBody,
		"maskedSecret":            maskedSecret,
		"normalizeConstraintKind": normalizeConstraintKind,
		"levelOf":                 levelOf,
	}
	for _, s := range oracleStrings {
		for name, f := range strToStr {
			rec(t, name, []any{s}, f(s), nil)
		}
		// (string) -> bool
		rec(t, "isMaskedSecret", []any{s}, isMaskedSecret(s), nil)
		rec(t, "validWorkerMessageRequestID", []any{s}, validWorkerMessageRequestID(s), nil)
		rec(t, "inheritedIntentResult", []any{s}, inheritedIntentResult(s), nil)
		rec(t, "validSkillName", []any{s}, validSkillName(s), nil)
		a, b := canonicalTaskID(s)
		rec(t, "canonicalTaskID", []any{s}, []any{a, b}, nil)
		// (string, default) -> int
		rec(t, "atoiDefault", []any{s, 7}, atoiDefault(s, 7), nil)
		rec(t, "portOr", []any{s, 9}, portOr(s, 9), nil)
		rec(t, "defaultPort", []any{s}, defaultPort(s), nil)
	}
	// (int) -> string
	for _, p := range []int{80, 443, 8443, 8080, 0, 1, 65535, -1, 12345} {
		rec(t, "schemeForPort", []any{p}, schemeForPort(p), nil)
	}
	for _, m := range []uint16{0, 8, 9, 12, 14, 20, 93, 95, 96, 97, 98, 99, 1, 7, 100, 65535} {
		rec(t, "zipMethodName", []any{m}, zipMethodName(m), nil)
	}
	// (rune)
	for _, r := range []rune{'a', 'Z', '0', '-', '/', '\\', '%', '#', '?', '*', ':', '"', '<', '>', '|', ' ', 0x1f, 0x7f, 0xfffd, 0x200d, 0x202e, 0x00a0, 0x3000, 'é', '日', 0xe000} {
		rec(t, "skillPathRune", []any{string(r)}, skillPathRune(r), nil)
	}
	// (string) -> (int64, error)
	for _, id := range oracleTaskIDs {
		n, err := parseTaskID(id)
		rec(t, "parseTaskID", []any{id}, n, err)
	}
	// (int64) -> string
	for _, n := range oracleInt64 {
		rec(t, "humanBytes", []any{n}, humanBytes(n), nil)
		rec(t, "i64s", []any{n}, i64s(n), nil)
		rec(t, "llmFailKey", []any{"task", n}, llmFailKey("task", n), nil)
	}
	// (bool) -> string
	for _, b := range []bool{true, false} {
		rec(t, "enabledWord", []any{b}, enabledWord(b), nil)
	}
	// (string, int) -> string
	for _, s := range oracleStrings {
		for _, n := range []int{0, 1, 5, 16, 1000} {
			rec(t, "preview", []any{s, n}, preview(s, n), nil)
			rec(t, "firstLine", []any{s, n}, firstLine(s, n), nil)
			rec(t, "trunc", []any{s, n}, trunc(s, n), nil)
		}
	}
}