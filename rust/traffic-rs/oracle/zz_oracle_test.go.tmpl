package traffic

// TEMPORARY oracle used by ../record.sh to regenerate cases.jsonl. Runs the real
// unexported Go helpers over a fixed corpus and prints one JSON object per call.
// record.sh copies this into traffic/, runs it, then deletes it — the package is
// left untouched.
//
// Corpus note: sanitize/clip truncate on a BYTE boundary (out[:120], s[:max]).
// The inputs below keep every truncation on an ASCII boundary, so the byte slice
// is always valid UTF-8 and the Rust port can mirror it exactly.

import (
	"bytes"
	"encoding/json"
	"fmt"
	"strings"
	"testing"

	"github.com/Autumn-27/artex/traffic/rewrite"
)

var oracleStrings = []string{
	"", "_", "normal_name", "a/b/c", "foo:bar", `quote"here`,
	"<tag>|pipe?star*", "back\\slash", "  spaced  ",
	"日本語/パス", "héllo/wörld",
	strings.Repeat("a", 119),
	strings.Repeat("a", 120),
	strings.Repeat("a", 121),
	strings.Repeat("a", 200),
	strings.Repeat("ab", 100), // 200 bytes, ASCII -> safe 120 cut
	"/leading/slash/", "///", ":::", "name.tar.gz",
	"plain", `has "quote"`, `nested ""x""`, `""`, "a\nb\tc",
}

var clipCases = []struct {
	s   string
	max int
}{
	{"hello world", 0}, {"hello world", 5}, {"hello world", 11}, {"hello world", 100},
	{strings.Repeat("x", 50), 10}, {strings.Repeat("x", 50), 49}, {strings.Repeat("x", 50), 50},
	{"", 0}, {"", 5}, {"short", 5}, {"short", 4},
	{"héllo", 100}, {"日本語テキスト", 100}, // unicode: only no-truncation path
	{"prefix "+strings.Repeat("y", 200)+" suffix", 20},
}

var oracleHeaders = []string{
	"Content-Type", "X-Custom_1", "", "bad header", "na:me",
	"ok!#$%&'*+-.^_`|~", "ümlaut", "tab\there", "newline\nhere",
	"UPPER", "lower", "0digit", "with.dot", "with-dash", "with_underscore",
	"space here", "semi;colon", "at@sign", "slash/es",
}

var oracleHosts = [][]string{
	{}, {"a.com"}, {"b.com", "a.com"}, {"A.COM", "a.com"},
	{" a.com ", "a.com"}, {"x", "", "y"}, {"", ""},
	{"z.com", "Z.COM", " z.com "}, {"例え.jp", "example.com"},
	{"host:80", "host:80", "HOST:80"}, {"a", "b", "c", "a", "b"},
	{"  ", "\t", "\n"}, {"MixedCase.NET", "mixedcase.net", "  MixedCase.Net  "},
}

// oracleBodies are the []byte inputs for clipBytes / truncateUTF8 / isBinaryBody /
// binaryTag. []byte marshals to base64 in Go's encoding/json; truncateUTF8 is
// recorded only over VALID UTF-8 bodies, so the byte-cut always lands on a rune
// boundary the Rust port can reproduce (see truncate_utf8).
var oracleBodies = [][]byte{
	[]byte(""), []byte("hello world"), []byte("abcdefghij"),
	[]byte("日本語テキスト"), []byte("héllo wörld"), []byte("😀emoji"),
	[]byte("ab\x00cd"), []byte("\x00\x01\x02\x03"), []byte("GIF89a......"),
	[]byte("münchen"), []byte("line1\nline2\ttab"),
	bytes.Repeat([]byte("x"), 600),
}

var oracleContentTypes = []string{
	"", "image/png", "IMAGE/PNG", " text/plain ", "application/json; charset=utf-8",
	"application/octet-stream", "audio/mpeg", "font/woff2", "application/zip",
	"text/html", "application/wasm", "application/x-shockwave-flash",
	"APPLICATION/PDF", "  ", "image", "application/vnd.android.package-archive; version=1",
	"video/mp4", "application/gzip",
}

var oracleByteNs = []int{0, 1, 2, 3, 4, 5, 6, 7, 100, 512, 1000}

// oracleRuleLines is the []rewrite.TraceLine corpus for appliedRules. Only Outcome
// and RuleID affect the result; the other fields stay at their zero value.
var oracleRuleLines = [][]rewrite.TraceLine{
	{},
	{{Outcome: "skipped"}, {Outcome: "pending"}},
	{{Outcome: "applied"}},
	{{Outcome: "applied", RuleID: 1}, {Outcome: "applied", RuleID: 2}},
	{{Outcome: "applied", RuleID: 1}, {Outcome: "applied", RuleID: 1}},
	{{Outcome: "applied", RuleID: 3}, {Outcome: "skipped", RuleID: 4}, {Outcome: "applied", RuleID: 3}},
	{{Outcome: "applied", RuleID: 0}, {Outcome: "applied", RuleID: 5}, {Outcome: "applied"}},
	{{Outcome: "skipped", RuleID: 9}},
	{{Outcome: "applied", RuleID: -1}, {Outcome: "applied", RuleID: -1}, {Outcome: "applied", RuleID: 2}},
	{{Outcome: "applied", RuleID: 7}, {Outcome: "applied", RuleID: 8}, {Outcome: "applied", RuleID: 9}},
}

func rec(t *testing.T, fn string, args []any, out any) {
	t.Helper()
	c := map[string]any{"fn": fn, "args": args, "ok": out}
	b, _ := json.Marshal(c)
	fmt.Println(string(b))
}

func TestZZOracle(t *testing.T) {
	for _, s := range oracleStrings {
		rec(t, "sanitize", []any{s}, sanitize(s))
		rec(t, "ftsQuote", []any{s}, ftsQuote(s))
		rec(t, "validHeaderName", []any{s}, validHeaderName(s))
	}
	for _, c := range clipCases {
		rec(t, "clip", []any{c.s, c.max}, clip(c.s, c.max))
	}
	for _, b := range []bool{true, false} {
		rec(t, "boolInt", []any{b}, boolInt(b))
	}
	for _, hs := range oracleHosts {
		rec(t, "uniqueArchiveHosts", []any{hs}, uniqueArchiveHosts(hs))
	}
	for _, body := range oracleBodies {
		for _, n := range oracleByteNs {
			rec(t, "clipBytes", []any{body, n}, clipBytes(body, n))
			rec(t, "truncateUTF8", []any{body, n}, truncateUTF8(body, n))
		}
		for _, ct := range oracleContentTypes {
			rec(t, "isBinaryBody", []any{ct, body}, isBinaryBody(ct, body))
			rec(t, "binaryTag", []any{ct, body}, binaryTag(ct, body))
		}
	}
	for _, lines := range oracleRuleLines {
		r, ids := appliedRules(lines)
		rec(t, "appliedRules", []any{lines}, []any{r, ids})
	}
}

func bytesRepeatA(n int) []byte {
	b := make([]byte, n)
	for i := range b {
		b[i] = 'a'
	}
	b[n-1] = 0 // single NUL at the very end (index n-1 >= 512 for n=600)
	return b
}

func TestZZOracle9aj(t *testing.T) {
	// rulesIsBinary(contentType, body)
	type rb struct {
		ct   string
		body []byte
	}
	rbCases := []rb{
		{"image/png", nil}, {"TEXT/PLAIN", []byte("hello")},
		{"application/zip", []byte("PK")}, {"text/html; charset=utf-8", []byte("<p>")},
		{"", []byte{0, 1, 2}}, {"", []byte("clean text")},
		{"application/octet-stream", nil}, {"application/json", []byte("no nul here")},
		{"video/mp4", []byte{}}, {"  image/jpeg  ", nil},
		{"text/plain", bytesRepeatA(600)}, // NUL only past the 512-byte clip
	}
	for _, c := range rbCases {
		rec(t, "rulesIsBinary", []any{c.ct, c.body}, rulesIsBinary(c.ct, c.body))
	}

	// proxyCausedErr(err.Error())
	errs := []string{
		"", "Head request failed", "unexpected HTTP2 framing",
		"http/2: server sent GOAWAY", "PROTOCOL ERROR", "protocol_error: bad",
		"malformed response", "Malformed header", "connection refused",
		"all good", "HTTP/2 timeout", "nomatchhere",
	}
	for _, e := range errs {
		rec(t, "proxyCausedErr", []any{e}, proxyCausedErr(fmt.Errorf("%s", e)))
	}
}

func TestZZOracle9aq(t *testing.T) {
	type cr struct {
		offset, length, size int64
	}
	for _, c := range []cr{
		{0, 10, 100},
		{-5, 10, 100},
		{200, 10, 100},
		{100, 10, 100},
		{90, 50, 100},
		{90, 0, 100},
		{90, -1, 100},
		{0, 0, 0},
		{0, 10, -1},
		{0, 1 << 62, 100},
		{50, 1 << 62, 100},
		{0, 10, 10},
		{10, 0, 10},
	} {
		off, n, empty := clampBlobRange(c.offset, c.length, c.size)
		rec(t, "clampBlobRange", []any{c.offset, c.length, c.size}, []any{off, n, empty})
	}
}
