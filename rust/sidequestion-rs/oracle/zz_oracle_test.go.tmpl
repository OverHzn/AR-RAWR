package sidequestion

// TEMPORARY oracle used by ../record.sh to regenerate cases.jsonl. Runs the real
// unexported method Parent.Key over a fixed corpus of Parent values and prints
// one JSON object per call. record.sh copies this into sidequestion/, runs it,
// then deletes it — the package is left untouched.

import (
	"encoding/json"
	"fmt"
	"testing"

	"github.com/Autumn-27/norma/llm"
)

var oracleParents = []Parent{
	{},
	{ConversationID: 5},
	{ConversationID: 1, TaskID: 9, ExplorationID: 3, IntentID: 7}, // conv wins
	{ConversationID: -1, IntentID: 3},                              // conv not >0 -> worker
	{TaskID: 3, ExplorationID: 2},                                  // main
	{TaskID: 3, ExplorationID: 2, IntentID: 7},                     // worker
	{TaskID: 42, ExplorationID: 1, IntentID: 0},
	{IntentID: 9}, // task-0-exp-0-worker-i9
	{TaskID: 7},   // task-7-exp-0-main
	{ConversationID: 123456789},
	{TaskID: -5, ExplorationID: -2, IntentID: -1}, // all <=0 -> task--5-exp--2-main
}

var oracleMaxTokens = []int{0, -1, 1, 4096, 8192, 100000, 32768, 32769, 65536}
var oracleConfigs = []int{0, -5, 1, 1024, 8192, 16384, 32768, 40000, 100000}
var oracleWindows = []int{0, -1, 1000, 8000, 128000, 200000, 1000000}
var oracleOutputs = []int{0, 1, 128, 1024, 8192, 100000}

func rec(t *testing.T, fn string, args []any, out any) {
	t.Helper()
	c := map[string]any{"fn": fn, "args": args, "ok": out}
	b, _ := json.Marshal(c)
	fmt.Println(string(b))
}

func TestZZOracle(t *testing.T) {
	for _, p := range oracleParents {
		rec(t, "Parent.Key", []any{p.ConversationID, p.TaskID, p.ExplorationID, p.IntentID}, p.Key())
	}
	for _, mt := range oracleMaxTokens {
		for _, cfg := range oracleConfigs {
			rec(t, "outputBudget", []any{mt, cfg}, outputBudget(llm.CompletionRequest{MaxTokens: mt}, cfg))
		}
	}
	for _, w := range oracleWindows {
		for _, out := range oracleOutputs {
			snap := Snapshot{Model: Model{WindowTokens: w}}
			rec(t, "inputBudget", []any{w, out}, inputBudget(snap, out))
		}
	}
}