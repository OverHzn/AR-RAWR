package db

// Temporary oracle: records ground-truth outputs of the unexported pure helpers
// in this package for the Rust parity harness. Copied in by record.sh, run under
// `go test -run TestZZOracle`, then deleted — the package is left untouched.
//
// Each line is a JSON object {fn, args, ok}. record.sh sorts the lines so the
// output is byte-reproducible.

import (
	"encoding/json"
	"fmt"
	"testing"
)

func rec(t *testing.T, fn string, args []any, out any) {
	t.Helper()
	c := map[string]any{"fn": fn, "args": args, "ok": out}
	b, _ := json.Marshal(c)
	fmt.Println(string(b))
}

func TestZZOracle(t *testing.T) {
	// nullIfEmpty(s)
	for _, s := range []string{"", "x", " ", "hello", "  spaced  ", "\t"} {
		rec(t, "nullIfEmpty", []any{s}, nullIfEmpty(s))
	}

	// isIdentStart(c) / isIdentChar(c) — c is a byte, recorded as its numeric value
	bytes := []byte{0, 9, 45, 48, 57, 64, 65, 90, 95, 97, 122, 128, 200, 255}
	for _, c := range bytes {
		rec(t, "isIdentStart", []any{int(c)}, isIdentStart(c))
		rec(t, "isIdentChar", []any{int(c)}, isIdentChar(c))
	}

	// marshalStringArray(items)
	nils := [][]string{
		nil,
		{},
		{""},
		{"a"},
		{"a", "b"},
		{"he said \"hi\""},
		{"a,b", "c"},
		{"back\\slash"},
		{"  spaced  "},
		{"quote\"and,comma", "tab\there"},
	}
	for _, items := range nils {
		rec(t, "marshalStringArray", []any{items}, marshalStringArray(items))
	}

	// nullableInt(v)
	for _, v := range []int{0, 1, -1, 42, -42, 1000000, -999999} {
		rec(t, "nullableInt", []any{v}, nullableInt(v))
	}
}