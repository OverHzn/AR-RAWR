package guard

// TEMPORARY oracle used by ../record.sh to regenerate cases.jsonl. Runs the real
// unexported Go helpers over a fixed corpus and prints one JSON object per call.
// record.sh copies this into guard/, runs it, then deletes it — the package is
// left untouched.

import (
	"encoding/json"
	"fmt"
	"strings"
	"testing"

	"github.com/Autumn-27/artex/intercept"
)

var oracleReasons = []string{
	"", "short", "a blocked reason", "target defense evasion",
	"pipe | and control\nchars", "unicode éè", "日本語の理由",
	strings.Repeat("a", 3999),
	strings.Repeat("a", 4000),
	strings.Repeat("a", 4001),
	strings.Repeat("a", 5000),
	strings.Repeat("é", 4001),  // 4001 runes, 8002 bytes
	strings.Repeat("日", 4001),  // 4001 runes, 12003 bytes
	"prefix " + strings.Repeat("x", 4000) + " suffix",
}

type oracleTarget struct {
	code, host string
	port       int
	reason     string
}

var oracleTargets = []oracleTarget{
	{"TARGET_APPROVAL_PENDING", "app.example.com", 443, "target not covered"},
	{"TARGET_DENIED", "10.0.0.5", 0, "operator denied"},
	{"TARGET_RESOLVE_FAILED", "", 0, "dns failed"},
	{"TARGET_RULE_BLOCKED", "host.with:colon", 8080, "rule blocked it"},
	{"TARGET_TOO_MANY", "h", 0, "too many new targets"},
	{"TARGET_GATE_UNAVAILABLE", "1.2.3.4", 22, "gate down"},
	{"UNKNOWN_CODE", "x.com", 0, "unknown code path"},
	{"TARGET_DENIED", "already-in-reason-host.com", 0, "mentions already-in-reason-host.com inside"},
	{"TARGET_APPROVAL_PENDING", "[2001:db8::1]", 443, "ipv6 host in brackets"},
	{"TARGET_APPROVAL_PENDING", "2001:db8::1", 443, "ipv6 raw host"},
	{"", "host-only", 0, "empty code"},
	{"TARGET_TOO_MANY", "", 0, "empty host"},
	{"TARGET_RULE_BLOCKED", "a.b.c", 0, strings.Repeat("x", 5000) + " a.b.c"},
	{"TARGET_DENIED", "h.example", 65535, "high port"},
}

func rec(t *testing.T, fn string, args []any, out any) {
	t.Helper()
	c := map[string]any{"fn": fn, "args": args, "ok": out}
	b, _ := json.Marshal(c)
	fmt.Println(string(b))
}

func TestZZOracle(t *testing.T) {
	for _, s := range oracleReasons {
		rec(t, "capBlockReason", []any{s}, capBlockReason(s))
		rec(t, "systemBlockMessage", []any{s}, systemBlockMessage(s))
	}
	for _, tc := range oracleTargets {
		tr := intercept.TargetResult{Code: tc.code, Host: tc.host, Port: tc.port, Reason: tc.reason}
		rec(t, "TargetBlockMessage", []any{tc.code, tc.host, tc.port, tc.reason}, TargetBlockMessage(tr))
	}
}