package llmpool

// Temporary oracle: records ground-truth outputs of the unexported pure helpers in
// this package for the Rust parity harness. Copied in by record.sh, run under
// `go test -run TestZZOracle`, then deleted — the package is left untouched.
//
// Each line is a JSON object {fn, args, ok}. record.sh sorts the lines so the
// output is byte-reproducible.

import (
	"encoding/json"
	"errors"
	"fmt"
	"strings"
	"testing"
)

func rec(t *testing.T, fn string, args []any, out any) {
	t.Helper()
	c := map[string]any{"fn": fn, "args": args, "ok": out}
	b, _ := json.Marshal(c)
	fmt.Println(string(b))
}

func TestZZOracle(t *testing.T) {
	// trimErr(err) — recorded by err.Error(); newlines -> spaces, trim, cap at 300 bytes
	msgs := []string{
		"",
		"simple error",
		"line1\nline2",
		"  padded  ",
		"trailing\n\n",
		"\n\n\n",
		"tab\there",
		"multi\nline\nerror\nwith\nnewlines",
		"unicode: café 世界",
		strings.Repeat("a", 300), // exactly 300 bytes -> unchanged
		strings.Repeat("a", 301), // one over -> 300-byte prefix + …
		strings.Repeat("a", 500), // well over
	}
	for _, m := range msgs {
		rec(t, "trimErr", []any{m}, trimErr(errors.New(m)))
	}
}